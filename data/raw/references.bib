@article{amei_global-scale_2026,
	title = {Global-scale biogeography of the pelagic polychaete family {Tomopteridae} ({Annelida}) revealed by {DNA} barcoding and genome-wide single nucleotide polymorphisms},
	volume = {243},
	issn = {0079-6611},
	url = {https://www.sciencedirect.com/science/article/pii/S0079661126000236},
	doi = {10.1016/j.pocean.2026.103689},
	abstract = {Zooplankton are essential members of marine ecosystems that respond sensitively to environmental changes. While the distribution patterns of zooplankton have been extensively investigated in the global ocean, pelagic polychaetes, particularly the Tomopteridae family, are underexplored in diversity and biogeography, due to their fragile bodies and subtle morphological traits. In the current study, mitochondrial cytochrome c oxidase subunit I (mtCOI), nuclear 28S rRNA, and genome-wide single-nucleotide polymorphisms (SNPs) were analyzed to characterize the diversity and distribution of tomopterid species globally. Phylogenetic analyses of mtCOI were conducted for 603 specimens collected from 54 stations across the global ocean. Concordance was detected between 14 mitochondrial lineages and their genome-wide SNPs, while species-level operational taxonomic units (OTUs) were defined based on mtCOI sequence similarity (≥ 2.4\%) supported by genome-wide SNPs. The comprising the global dataset contained 35 OTUs and 17 singletons, representing at least 52 tomopterid species. The number of species we assumed in this study exceeds previous morphological reports from certain ocean regions, including the eastern and western North Pacific Ocean (18 OTUs:11 species and 9 OTUs:7 species, respectively), suggesting the existence of previously unrecognized species. No specimens in this study were classified to species by morphotaxonomy. Tomopterids exhibited distribution patterns that corresponding to the general biogeography of other zooplankton, including subarctic/boreal, subarctic/bipolar, temperate–subtropical/circumglobal, temperate-subtropical/Indo-Pacific, equatorial, and upwelling region distributions. As this is the first species-level study of the global-scale biogeography of Tomopteridae, the findings provide fundamental information for future ecological and evolutionary studies on tomopterids.},
	urldate = {2026-02-19},
	journal = {Progress in Oceanography},
	author = {Amei, Kanako and Hirai, Junya and Goetze, Erica and Nishibe, Yuichiro},
	month = mar,
	year = {2026},
	keywords = {Biogeography, NBSS\_L\_observed, Annelida, Barcoding, Genome-wide SNPs, Holopelagic, Potential species diversity, Tomopteridae},
	pages = {103689},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\alexc\\Zotero\\storage\\V4EI25RV\\Amei et al. - 2026 - Global-scale biogeography of the pelagic polychaete family Tomopteridae (Annelida) revealed by DNA b.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\alexc\\Zotero\\storage\\EV75R486\\S0079661126000236.html:text/html},
}

@article{allen_population_1984,
	title = {Population {Dynamics} of the {Mysid} {Shrimp} {Mysidopsis} bigelowi {W}. {M}. {Tattersall} in a {Temperate} {Estuary}},
	volume = {4},
	issn = {0278-0372},
	url = {https://www.jstor.org/stable/1547893},
	doi = {10.2307/1547893},
	abstract = {Mysidopsis bigelowi, a common epibenthic mysid crustacean, was collected in a New Jersey estuary to determine its seasonal abundance, distribution, and life history pattern. Mysids were sampled with an epibenthic sled, and densities of M. bigelowi were among the highest reported for any shallow-water mysid. This mysid occurred in all subtidal areas of the high salinity embayment throughout the year, but was most abundant in sandy habitats near the inlet and in the ocean. Variations in abundance between stations and between cruises, which were often greater than two orders of magnitude, were attributed to patchy distribution and a high degree of motility. A significant correlation was observed between the abundance of M. bigelowi and that of the dominant sympatric mysid Neomysis americana. An inshore migration of adult M. bigelowi in spring coincided with the onset of reproduction of the overwintering generation. Females from 4.4-8.5 mm total length incubated from 5-43 young; the mean was 17.4. The number of eggs or larvae was linearly related to female length. Individuals produced multiple broods and reproduction was continuous from April through November. Abundance, distribution, and life history adaptations of M. bigelowi in Hereford Inlet are compared to those of populations from New England to Texas.},
	number = {1},
	urldate = {2026-02-19},
	journal = {Journal of Crustacean Biology},
	publisher = {[Brill, Crustacean Society]},
	author = {Allen, Dennis M.},
	year = {1984},
	keywords = {NBSS\_L\_observed},
	pages = {25--34},
	file = {JSTOR Full Text PDF:C\:\\Users\\alexc\\Zotero\\storage\\K5HI62CD\\Allen - 1984 - Population Dynamics of the Mysid Shrimp Mysidopsis bigelowi W. M. Tattersall in a Temperate Estuary.pdf:application/pdf},
}

