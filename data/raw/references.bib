	pages = {31--40},
	file = {Full Text PDF:C\:\\Users\\alexc\\Zotero\\storage\\XID955DH\\Davis - 1984 - Predatory control of copepod seasonal cycles on Georges Bank.pdf:application/pdf},
}

@article{yamaguchi_vertical_2000,
	title = {Vertical distribution, life cycle and body allometry of two oceanic calanoid copepods ({Pleuromamma} scutullata and {Heterorhabdus} tanneri) in the {Oyashio} region, western {North} {Pacific} {Ocean}},
