@article{klein_breteler_growth_1982,
	title = {Growth and development of four calanoid copepod species under experimental and natural conditions},
	volume = {16},
	issn = {0077-7579},
	url = {https://www.sciencedirect.com/science/article/pii/0077757982900308},
	doi = {10.1016/0077-7579(82)90030-8},
	abstract = {The growth in 4 pelagic marine copepods, Acartia clausi, Temora longicornis, Centropages hamatus and Pseudocalanus sp. was studied. In laboratory experiments the rate of development of successive cohorts was estimated at different food concentrations at 15° C. The development of mixed field populations of the North Sea was estimated by a multiple linear regression method. The relation between length and ash-free dry weight of cultured animals was established for all developmental stages (except N I) and weight specific growth rates were calculated accordingly. The growth of nauplii and copepodites in the North Sea was probably food-limited in summer, and the more severe in the older copepodid stages. Species and stage specific responses to food composition were supposedly found.},
	urldate = {2026-01-30},
	journal = {Netherlands Journal of Sea Research},
	author = {Klein Breteler, W. C. M. and Fransz, H. G. and Gonzalez, S. R.},
	month = dec,
	year = {1982},
	keywords = {NBSS\_LW\_equation},
	pages = {195--207},
	file = {PDF:C\:\\Users\\alexc\\Zotero\\storage\\2RL49DUH\\Klein Breteler et al. - 1982 - Growth and development of four calanoid copepod species under experimental and natural conditions.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\alexc\\Zotero\\storage\\H9DYIITW\\0077757982900308.html:text/html},
}

