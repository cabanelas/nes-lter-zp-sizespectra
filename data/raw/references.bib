@article{lima_influence_1985,
	title = {The influence of temperature on growth rate and length of larval life of the gastropod, {Crepidula} plana {Say}},
	volume = {90},
	copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {00220981},
	url = {https://linkinghub.elsevier.com/retrieve/pii/0022098185900747},
	doi = {10.1016/0022-0981(85)90074-7},
	abstract = {The relationship between rate of larval development and the potential to prolong larval life was examined for larvae of the marine prosobranch gastropod Crepidula pkma Say. Larvae were maintained in clean glass dishes at constant temperatures ranging from 12-29 “C and fed either Isochrysis galbana Parke (ISO) or a Tahitian strain of1sochrysi.r species (T-IS@. Under all conditions, larvae grew at constant rates, as determined by measurements of shell length and tissue biomass. Most larvae eventually underwent spontaneous metamorphosis. Regardless of temperature, faster growth was associated with a shorter planktonic stage prior to spontaneous metamorphosis. Within an experiment, higher temperatures generally accelerated growth rates and reduced the number of days from hatching to spontaneous metamorphosis. However, growth rates were independent of temperature for larvae fed IS0 at 25 and 29 “C and for larvae fed T-IS0 at 20 and 25 “C. Where growth rates were unaffected by temperature, time to spontaneous metamorphosis was similarly unaffected. Maximum durations of larval life at a given temperature were shorter for larvae of Crepidula plana than for those of the congener C.fornicatu (L.), although both species grew at comparable rates. Interpretations of the ecological significance of these interspecific differences in delay capabilities will require additional data on adult distributions and larval dispersal patterns in the field.},
	language = {en},
	number = {1},
	urldate = {2026-02-11},
	journal = {Journal of Experimental Marine Biology and Ecology},
	author = {Lima, Gail M. and Pechenik, Jan A.},
	month = jul,
	year = {1985},
	keywords = {NBSS\_W\_observed, NBSS\_L\_observed},
	pages = {55--71},
	file = {PDF:C\:\\Users\\alexc\\Zotero\\storage\\DN7HY45C\\Lima and Pechenik - 1985 - The influence of temperature on growth rate and length of larval life of the gastropod, Crepidula pl.pdf:application/pdf},
}

