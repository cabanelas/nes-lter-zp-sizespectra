}

@article{barria_larval_2006,
	title = {{LARVAL} {DEVELOPMENT} {OF} {THE} {HERMIT} {CRAB} {PAGURUS} {EDWARDSII} ({DECAPODA}: {ANOMURA}: {PAGURIDAE}) {UNDER} {LABORATORY} {CONDITIONS}},
	volume = {26},
	issn = {0278-0372, 1937-240X},
	shorttitle = {{LARVAL} {DEVELOPMENT} {OF} {THE} {HERMIT} {CRAB} {PAGURUS} {EDWARDSII} ({DECAPODA}},
	url = {https://complete.bioone.org/journals/journal-of-crustacean-biology/volume-26/issue-2/C-2577.1/LARVAL-DEVELOPMENT-OF-THE-HERMIT-CRAB-PAGURUS-EDWARDSII-DECAPODA/10.1651/C-2577.1.full},
	doi = {10.1651/C-2577.1},
	abstract = {The first description of the larval stages of a representative of the family Paguridae from the SE Pacific coast of South America is presented. Larvae of Pagurus edwardsii, a common hermit crab from the rocky intertidal environment of the Chilean coast, were reared in the laboratory from hatching through the molt to juvenile stage I. Culture conditions included water temperature of 11 ± 1°C, salinity 32 ± 1‰, 12h:12h light : dark photoperiod, and feeding with Artemia sp. nauplii. The larval development of P. edwardsii included four zoeal stages (ZI–ZIV) and one megalopal stage; the duration in days for each zoeal stage was: ZI: 18.9 ± 0.5, ZII: 12.8 ± 0.8, ZIII: 5.9 ± 0.2, ZIV: 5.6 ± 0.6; and 9.1 ± 0.4 days for the megalopal stage. Descriptions and detailed illustrations are presented for each of the larval stages. Morphological comparisons made between P. edwardsii and other congeneric species with larval desciptions showed the main characteristics for the diagnosis of zoeal stages are: a) setation of antennal endopod and scaphocerite; b) spination and setation pattern of the basal endite of the maxilulle; c) setal formula of the endopodite of maxilliped 1; d) the segmentation model of the sixth pleomere; and e) the formula for the processes in the posterior margin of the telson. In contrast, the megalopal larva can be recognized by the number of setae on the endopod of maxilliped 3 and the absence of apical hooks on the appendix interna of the pleopods.},
	number = {2},
	urldate = {2026-02-11},
	journal = {Journal of Crustacean Biology},
	publisher = {The Crustacean Society},
	author = {Barria, Erwin M. and DaForno, Eduardo E. and Jara, Carlos G.},
	month = may,
	year = {2006},
	keywords = {NBSS\_L\_observed},
	pages = {154--167},
	file = {Full Text PDF:C\:\\Users\\alexc\\Zotero\\storage\\FP3YWEPX\\Barria et al. - 2006 - LARVAL DEVELOPMENT OF THE HERMIT CRAB PAGURUS EDWARDSII (DECAPODA ANOMURA PAGURIDAE) UNDER LABORAT.pdf:application/pdf},
}

