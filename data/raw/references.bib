	url = {https://www.jstor.org/stable/20101678},
	abstract = {Der Copepode Centropages typicus wurde in mehreren aufeinanderfolgenden Generationen im Labor gezüchtet. Die Entwicklungsdauer vom Ei bis zum Adultus betrug 19 und 23 Tage bei einer Temperatur von 18°-19°C. Das Ei, sechs Nauplius Stadien, fünf Copepodid Stadien und die Adulti beiderlei Geschlechts wurden beschrieben und illustriert. Die Geschlechter sind frühestens im vierten Copepodid-Stadium zu differenzieren. Ei, Nauplius-Stadium und Copepodid-Stadium von C. typicus und C. hamatus wurden verglichen und deutliche Unterschiede festgestellt.},
	number = {2},
	urldate = {2026-01-30},
	journal = {Crustaceana},
	publisher = {Brill},
	author = {Lawson, Thomas J. and Grice, George D.},
	year = {1970},
	keywords = {NBSS\_LW\_equation, NBSS\_L\_observed},
	pages = {187--208},
	file = {JSTOR Full Text PDF:C\:\\Users\\alexc\\Zotero\\storage\\QPMPEWPF\\Lawson and Grice - 1970 - The Developmental Stages of Centropages typicus Krøyer (Copepoda, Calanoida).pdf:application/pdf},
}

@article{zakaria_biomass_2018,
	title = {Biomass determination based on the individual volume of the dominant copepod species in the {Western} {Egyptian} {Mediterranean} {Coast}},
	volume = {44},
	issn = {1687-4285},
	url = {https://www.sciencedirect.com/science/article/pii/S1687428518300220},
	doi = {10.1016/j.ejar.2018.05.002},
	abstract = {The biomass of five copepod species (Oithona nana, Calocalanus pavo, Nannocalanus minor, Clausocalanus arcuicornis and Paracalanus parvus) that dominate the western part of the Egyptian Mediterranean Coast had been determined using the individual volume. The length-weight relationships and physicochemical influences on the length of species were also investigated. Copepod samples were seasonally collected during the period 2008–2009. All volumes and weights of the randomly selected adult individuals were measured. Ten regression equations confirmed that; the species weights depend on the total lengths of males and females of all species. However, the females of the examined species were always heavier and longer than males. The length and weight of both sexes of all species were higher in winter than in other seasons. Temperature is considered the main factor influencing the sizes of adult copepods. It was also found that the mean length of the examined individuals was inversely proportional to temperature. However, all the investigated organisms had adequate high levels of dissolved oxygen and didn't show any change with pH, salinity and transparency.},
	number = {2},
	urldate = {2026-01-30},
	journal = {Egyptian Journal of Aquatic Research},
	author = {Zakaria, Howaida Y. and Hassan, Abdel-Kader M. and El-Naggar, Hussein A. and Abo-Senna, Fekry M.},
	month = jun,
	year = {2018},
	keywords = {Biomass, Copepods, Egyptian Coast, Length-weight relationships, Mediterranean, NBSS\_LW\_equation, NBSS\_W\_observed, NBSS\_L\_observed},
	pages = {89--99},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\alexc\\Zotero\\storage\\ACYSQKN9\\Zakaria et al. - 2018 - Biomass determination based on the individual volume of the dominant copepod species in the Western.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\alexc\\Zotero\\storage\\968PB8LB\\S1687428518300220.html:text/html},
}

