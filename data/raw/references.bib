@article{hopcroft_production_1998,
	title = {Production of tropical copepods in {Kingston} {Harbour}, {Jamaica}:  the importance of small species},
	volume = {130},
	issn = {1432-1793},
	shorttitle = {Production of tropical copepods in {Kingston} {Harbour}, {Jamaica}},
	url = {https://doi.org/10.1007/s002270050281},
	doi = {10.1007/s002270050281},
	abstract = {The copepod community observed during an 18-month period at the mouth of eutrophic Kingston Harbour, Jamaica, was dominated by small species of Parvocalanus, Temora, Oithona, and Corycaeus. Mean copepod biomass was 22.1  mg AFDW m−3 (331   mg m−2). Annual production was 1679 kJ m−2, partitioned as 174 kJ m−2 naupliar, 936 kJ m−2 copepodite, 475 kJ m−2 egg and 93 kJ m−2 exuvial production. All nauplii, most copepodites and many adults, equivalent to half of the biomass and production, were missed by a standard 200-μm plankton net, emphasizing the importance of nauplii and small species in secondary production estimates. The evidence suggests that growth rates and production are generally not food limited, and we speculate that size-selective predation shapes the structure of the harbour community. Biomass and production are higher than previous estimates for tropical coastal waters, but comparable to other eutrophic tropical embayments and many productive temperate ecosystems. Far from being regions of low productivity, tropical zooplankton communities may have significant production and deserve greater research attention than they currently receive.},
	language = {en},
	number = {4},
	urldate = {2026-02-09},
	journal = {Marine Biology},
	author = {Hopcroft, R. R. and Roff, J. C. and Lombard, D.},
	month = mar,
	year = {1998},
	keywords = {Biomass, NBSS\_LW\_equation, NBSS\_L\_observed, Research Attention, Significant Production, Small Species, Zooplankton Community},
	pages = {593--604},
	file = {Full Text PDF:C\:\\Users\\alexc\\Zotero\\storage\\K56N3MMM\\Hopcroft et al. - 1998 - Production of tropical copepods in Kingston Harbour, Jamaica  the importance of small species.pdf:application/pdf},
}

@article{koguchi_inter-species_2022,
	title = {Inter-species comparison of the copepodite stage morphology, vertical distribution, and seasonal population structure of five sympatric mesopelagic aetideid copepods in the western {Arctic} {Ocean}},
	volume = {9},
	issn = {2296-7745},
	url = {https://www.frontiersin.org/journals/marine-science/articles/10.3389/fmars.2022.943100/full},
	doi = {10.3389/fmars.2022.943100},
	abstract = {Aetideidae is a calanoid copepod family dominant in the mesopelagic layer of the Arctic Ocean for which little ecological information is available because species identification, especially of early copepodite stages, is difficult. In this study, keys for identification of early copepodite stages of five sympatric aetideid copepods (Chiridius obtusifrons, Gaetanus tenuispinus, G. brevispinus, Aetideopsis multiserrata, and A. rostrata) were developed and the vertical distributions and seasonal population structures of these species were evaluated using a year-round sample time-series collected at the drifting ice station (SHEBA) in the western Arctic Ocean. Combinations of morphological characteristics (prosome length, cephalosome, and prosome widths) were used to identify the early copepodite stages to species. Aetideopsis rostrata was distributed in deep waters (1,032–1,065 m) throughout the year. The other species all were found at 600–700 m during the midnight sun. However, during the polar night, the vertical distributions of each species were distinct, resulting from ascent, descent, or depth maintenance, indicating seasonal vertical migration which may function to reduce inter-specific competition during the polar night when food resources are scarce. Except for the deepest dwelling A. rostrata, reproduction timing also varied among these four aetideid copepods: C. obtusifrons and G. tenuispinus showed polar night ascent and reproduction at the end of the polar night, whereas G. brevispinus and A. multiserrata showed descent or depth maintenance during the polar night and reproduction at the beginning of the polar night. Common for all aetideid species, δ15N values of the adult females indicate more carnivorous feeding modes during the polar night than those in the midnight sun. Such vertical distribution and timing of reproduction variation among these five aetideid copepods may function to reduce species competition in the mesopelagic layer of the Arctic Ocean.},
	language = {English},
	urldate = {2026-02-09},
	journal = {Frontiers in Marine Science},
	publisher = {Frontiers},
	author = {Koguchi, Yunosuke and Tokuhiro, Koki and Ashjian, Carin J. and Campbell, Robert G. and Yamaguchi, Atsushi},
	month = aug,
	year = {2022},
	keywords = {Reproduction, NBSS\_W\_observed, NBSS\_L\_observed, Aetideidae, population structure, sympatric mesopelagic copepods, The arctic ocean, vertical distribution},
	file = {Full Text PDF:C\:\\Users\\alexc\\Zotero\\storage\\KYS69SAW\\Koguchi et al. - 2022 - Inter-species comparison of the copepodite stage morphology, vertical distribution, and seasonal pop.pdf:application/pdf;Table 1:C\:\\Users\\alexc\\Zotero\\storage\\BHB2UEAC\\Table 1.XLSX:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;Table 2:C\:\\Users\\alexc\\Zotero\\storage\\69YJKCFA\\Table 2.XLSX:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;Table 3:C\:\\Users\\alexc\\Zotero\\storage\\AMBHRKJK\\Table 3.XLSX:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;Table 4:C\:\\Users\\alexc\\Zotero\\storage\\KS7CT6B4\\Table 4.XLSX:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;Table 5:C\:\\Users\\alexc\\Zotero\\storage\\TCNR3C9D\\Table 5.XLSX:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;Table 6:C\:\\Users\\alexc\\Zotero\\storage\\YDD9XHZL\\Table 6.XLSX:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;Table 7:C\:\\Users\\alexc\\Zotero\\storage\\8V5577BU\\Table 7.XLSX:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;Table 8:C\:\\Users\\alexc\\Zotero\\storage\\QB7R8YC7\\Table 8.XLSX:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;Table 9:C\:\\Users\\alexc\\Zotero\\storage\\DJY8CFW6\\Table 9.XLSX:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet},
}

