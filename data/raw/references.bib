	url = {https://doi.org/10.1080/00785236.1982.10426580},
	doi = {10.1080/00785236.1982.10426580},
	abstract = {To make an energy budget for Mytilus edulis larvae several parameters — dry weight/shell length relationship, feeding rates at different algal concentrations and growth in relation to time and algal concentration — were measured in the laboratory. Experiments were carried out at a temperature of 15 °C and the naked flagellates Isochrysis galbana and Monochrysis lutheri were used as food. The relation between soft tissue dry weight and shell length could be expressed by the equation: W(µg) = 2.53 · 10−9 L(µm)3.49 for larvae and W(µg) = 24.7 L(µm)2.42 for young post-metamorphic mussels. The organic parts of the shells constituted about 10\% of the total organic content. Clearance (C, µl · h−1) at an algal concentration of 3–12 cells · µl−1 was related to shell length (L, µm) according to the equation: C = 1.25 · 10−5 L 2.85. At increasing algal concentration clearance decreased. Ingestion rate, calculated as the product of clearance and algal concentration, increased with increasing algal concentration up to 40–50 cells · µl−1. Shell length increased with time, the daily increase in length being 7–8 µm at an algal concentration of 50 cells · µl−1. Growth increased with algal concentrations up to 40–50 cells · µl−1. Energy budgets calculated for two sizes of larvae showed net growth efficiencies between 43–73\%, gross growth efficiencies between 19–26\% and assimilation efficiencies between 31–45\%.},
	number = {1},
	urldate = {2026-03-02},
	journal = {Ophelia},
	publisher = {Taylor \& Francis},
	author = {Jespersen, Henrik and Olsen, Karin},
	month = jun,
	year = {1982},
	note = {\_eprint: https://doi.org/10.1080/00785236.1982.10426580},
	keywords = {NBSS\_LW\_equation},
	pages = {101--113},
	file = {PDF:C\:\\Users\\alexc\\Zotero\\storage\\AQRPVTLE\\Jespersen and Olsen - 1982 - Bioenergetics in veliger larvae of Mytilus edulis L..pdf:application/pdf},
}

